---
// /concepts — 3 тональные вариации УТВЕРЖДЁННОГО макета статьи (ref: Desktop-7).
// Общий каркас: full-bleed фото-hero + оверлей-шапка (наличник × СМИ2) +
// центрированный белый титул + дата, ниже — светлое тело статьи узкой колонкой.
// Направления различаются тоном/типографикой/декором, НЕ структурой.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logo = `${base}/logo/lockup.svg`;
const heroImg = `${base}/hero/wine.jpg`;

const hero = {
  cat: 'Новости',
  title: 'Русское вино — чемпион: «Абрау-Дюрсо» обошло 17 стран на международном конкурсе',
  date: '26.06.2026',
};
const body = [
  'Международное жюри ведущего израильского конкурса TERRAVINO впервые в истории присудило звание Grand Champion International российскому производителю. Титул, который получает только одно вино — лучшее среди всех участников, — завоевало классическое игристое Brut d’Or Riesling 2022 от Группы компаний «Абрау-Дюрсо».',
  'Юбилейный, 20-й конкурс TERRAVINO, прошедший в Тель-Авиве, собрал 578 образцов из 18 стран мира. Дегустация проходила вслепую по стандартам Международной организации винограда и вина (OIV) — это гарантирует объективность оценки и делает победу особенно престижной.',
  'Как отметил владелец группы компаний «Абрау-Дюрсо» Борис Титов, победа на TERRAVINO — важный шаг для всего российского виноделия: «Первый случай, когда российский производитель получил звание Гранд-чемпиона на ведущем дегустационном конкурсе Израиля».',
];
const cards = [
  { cat: 'Обзор', cover: `${base}/covers/kosmetika-podborka.svg`, title: 'Женское вино: что предпочитают представительницы новой волны', date: '21.06.2026' },
  { cat: 'История', cover: `${base}/covers/chaynaya-masterskaya.svg`, title: 'Винная карта России перекраивает меню ресторанов', date: '18.06.2026' },
  { cat: 'Интервью', cover: `${base}/covers/keramika-gromov.svg`, title: 'Сомелье хвалят «Абрау-Дюрсо»: соцсети диктуют моду', date: '15.06.2026' },
];

const concepts = [
  { id: 'chistoe', n: '01', name: 'Чистое', sub: 'Editorial', tag: 'ближе всего к утверждённому макету',
    blurb: 'Точное прочтение утверждённого макета: чистый гротеск-титул, минимум декора, белое тело статьи. Наличник несёт всю «русскость».' },
  { id: 'nalichnik', n: '02', name: 'Наличник', sub: 'Резьба', tag: 'тёплое, serif, золотой акцент',
    blurb: 'Тот же макет, но теплее: serif-титул (Cormorant), кремовое тело с буквицей, золотая дата и розетка-делитель. Редакционная роскошь.' },
  { id: 'zoloto', n: '03', name: 'Золото', sub: 'Империя', tag: 'тёмное тело, церемониально',
    blurb: 'Тот же макет в тёмном ключе: тело статьи на чернильном фоне, золотой serif и золочёные хайрлайны. Дворец/музей, максимум статуса.' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
    <title>Русский бренд — 3 тональные вариации макета</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&family=Oswald:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      body { margin: 0; background: #e7e3db; color: #2c2825; font-family: Inter, system-ui, sans-serif; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      :focus-visible { outline: 2px solid #9b080e; outline-offset: 3px; border-radius: 2px; }

      /* ---------- страничный каркас сравнения ---------- */
      .page-head { max-width: 1100px; margin: 0 auto; padding: 56px 24px 4px; }
      .kicker { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .28em;
        font-size: 12px; font-weight: 600; color: #9b080e; }
      .page-head h1 { font-family: 'Cormorant Garamond', serif; font-weight: 600;
        font-size: clamp(30px, 5vw, 48px); line-height: 1.05; margin: 10px 0 8px; }
      .page-head p { max-width: 64ch; color: #57514a; font-size: 15.5px; line-height: 1.6; margin: 0; }

      .summary { max-width: 1100px; margin: 24px auto 4px; padding: 0 24px;
        display: grid; gap: 14px; grid-template-columns: repeat(3, 1fr); }
      @media (max-width: 860px) { .summary { grid-template-columns: 1fr; } }
      .sum { background: #fff; border: 1px solid #d9d3c8; border-radius: 12px; padding: 16px 16px 18px; }
      .sum__top { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
      .sum__n { font-family: Oswald, sans-serif; font-weight: 600; color: #b7b0a4; font-size: 13px; }
      .sum__name { font-family: 'Cormorant Garamond', serif; font-size: 25px; font-weight: 600; }
      .sum__sub { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .2em;
        font-size: 10px; color: #9b080e; margin-left: auto; }
      .sum__blurb { font-size: 13px; line-height: 1.55; color: #57514a; margin: 6px 0 12px; }
      .sw { display: flex; gap: 6px; margin-bottom: 12px; }
      .sw span { width: 24px; height: 24px; border-radius: 6px; border: 1px solid rgba(0,0,0,.08); }
      .jump { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .16em;
        font-size: 11px; font-weight: 600; color: #2c2825; border-bottom: 1px solid #9b080e; padding-bottom: 2px; }

      /* ---------- логотип-наличник (маска, тинт под концепт) ---------- */
      .logo { width: 132px; aspect-ratio: 400 / 170;
        -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat;
        background: var(--logo-c, #fff); flex: none; }

      /* ==================================================================
         Каркас «живой» статьи — читает локальные токены концепта
      ================================================================== */
      .band { border-top: 1px solid rgba(0,0,0,.08); scroll-margin-top: 0; }
      .band__label { max-width: 1180px; margin: 0 auto; padding: 20px 24px 12px;
        display: flex; align-items: baseline; gap: 14px; }
      .band__num { font-family: Oswald, sans-serif; font-weight: 600; font-size: 13px; color: #b7b0a4; }
      .band__name { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .22em;
        font-size: 13px; font-weight: 600; color: #9b080e; }
      .band__tag { margin-left: auto; font-size: 12px; color: #8a8278; font-style: italic; }

      /* hero — full-bleed фото + оверлей */
      .hero { position: relative; min-height: min(78vh, 620px); display: flex; flex-direction: column;
        background: #14110f; overflow: hidden; }
      .hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .hero__scrim { position: absolute; inset: 0;
        background: linear-gradient(to bottom, rgba(10,8,6,.45) 0%, rgba(10,8,6,.12) 38%, rgba(10,8,6,.78) 100%); }
      .hero__nav { position: relative; z-index: 2; display: flex; align-items: center; gap: 16px;
        padding: clamp(20px, 3vw, 34px) clamp(22px, 4vw, 56px); }
      .hero__x { color: rgba(255,255,255,.7); font-size: 18px; }
      .smi2 { display: inline-flex; align-items: center; gap: 8px; color: #fff;
        font-family: Oswald, sans-serif; font-weight: 500; letter-spacing: .1em; font-size: 16px; text-transform: uppercase; }
      .smi2 b { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
        background: #fff; color: #14110f; font-family: Inter, sans-serif; font-weight: 700; font-size: 14px; }
      .hero__center { position: relative; z-index: 2; margin-top: auto;
        padding: clamp(28px, 5vw, 60px) clamp(22px, 6vw, 90px) clamp(40px, 6vw, 72px); text-align: center; }
      .hero__eyebrow { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .24em;
        font-size: 11px; font-weight: 600; color: var(--hero-accent, #fff); opacity: .9; margin-bottom: 14px; }
      .hero__title { color: #fff; margin: 0 auto; max-width: 20ch;
        font-family: var(--title-font); font-weight: var(--title-weight); line-height: 1.14;
        font-size: clamp(26px, 3.6vw, 44px); }
      .hero__date { margin-top: 18px; font-family: Oswald, sans-serif; letter-spacing: .18em;
        font-size: 13px; color: var(--date-color, rgba(255,255,255,.72)); }

      /* тело статьи */
      .body { background: var(--body-bg); color: var(--body-ink); }
      .body__col { max-width: 720px; margin: 0 auto; padding: clamp(40px, 6vw, 76px) 24px clamp(32px,4vw,52px); }
      .body__col p { font-size: 18px; line-height: 1.75; margin: 0 0 22px; }
      .body__col p:first-of-type { font-size: 20px; color: var(--body-lead, var(--body-ink)); }
      .rosette { display: flex; align-items: center; justify-content: center; gap: 16px;
        color: var(--gold, #c6a25e); margin: 4px auto 30px; max-width: 720px; }
      .rosette::before, .rosette::after { content: ''; width: 90px; height: 1px; background: currentColor; opacity: .55; }
      .rosette svg { width: 30px; height: 30px; }

      /* «ещё по теме» */
      .also { background: var(--body-bg); border-top: 1px solid var(--line, rgba(0,0,0,.08)); }
      .also__in { max-width: 1100px; margin: 0 auto; padding: 8px 24px clamp(48px,6vw,72px); }
      .also__h { font-family: var(--title-font); font-weight: var(--title-weight); color: var(--body-ink);
        font-size: 24px; margin: 24px 0 20px; }
      .grid { display: grid; gap: 22px; grid-template-columns: repeat(3, 1fr); }
      @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
      .card { display: block; }
      .card__img { aspect-ratio: 3 / 2; width: 100%; object-fit: cover; border-radius: var(--radius, 4px);
        background: rgba(0,0,0,.05); }
      .card__cat { display: inline-block; margin: 12px 0 8px; font-family: Oswald, sans-serif;
        text-transform: uppercase; letter-spacing: .16em; font-size: 10px; font-weight: 600; color: var(--accent); }
      .card__title { font-family: var(--title-font); font-weight: var(--title-weight); color: var(--body-ink);
        font-size: 18px; line-height: 1.28; margin: 0 0 8px; }
      .card__date { font-family: Oswald, sans-serif; font-size: 11px; letter-spacing: .12em; color: var(--body-muted); }

      /* ==================================================================
         01 · ЧИСТОЕ — точное прочтение утверждённого макета
      ================================================================== */
      [data-c='chistoe'] {
        --title-font: Inter, sans-serif; --title-weight: 600;
        --body-bg: #fbfaf7; --body-ink: #1f1c18; --body-lead: #1f1c18; --body-muted: #8a8278;
        --accent: #9b080e; --gold: #9b080e; --line: #ece7dd; --radius: 6px;
        --date-color: rgba(255,255,255,.78); --logo-c: #fff;
      }
      [data-c='chistoe'] .rosette { display: none; }

      /* ==================================================================
         02 · НАЛИЧНИК — тёплое, serif, золотой акцент
      ================================================================== */
      [data-c='nalichnik'] {
        --title-font: 'Cormorant Garamond', serif; --title-weight: 600;
        --body-bg: #f5ebd9; --body-ink: #2f2318; --body-lead: #4a3826; --body-muted: #9c8465;
        --accent: #9b080e; --gold: #b8893a; --line: #e0cfab; --radius: 4px;
        --hero-accent: #e8c98b; --date-color: #e6c98f; --logo-c: #f3e7cf;
      }
      [data-c='nalichnik'] .hero__title { font-size: clamp(30px, 4.4vw, 52px); }
      /* буквица */
      [data-c='nalichnik'] .body__col p:first-of-type::first-letter {
        font-family: 'Cormorant Garamond', serif; font-weight: 700; float: left; line-height: .8;
        font-size: 68px; padding: 6px 12px 0 0; color: var(--accent); }

      /* ==================================================================
         03 · ЗОЛОТО — тёмное тело, церемониальное золото
      ================================================================== */
      [data-c='zoloto'] {
        --title-font: 'Cormorant Garamond', serif; --title-weight: 500;
        --body-bg: #171009; --body-ink: #ece2cd; --body-lead: #f3ead6; --body-muted: #9a8a68;
        --accent: #c6a25e; --gold: #c6a25e; --line: rgba(198,162,94,.28); --radius: 2px;
        --hero-accent: #d9b877; --date-color: #d9b877; --logo-c: #d9b877;
      }
      [data-c='zoloto'] .hero__title { color: #f0e2c4; }
      [data-c='zoloto'] .smi2 b { background: #c6a25e; color: #171009; }
      [data-c='zoloto'] .body__col { text-align: center; }
      [data-c='zoloto'] .body__col p:first-of-type { color: var(--gold); font-family: 'Cormorant Garamond', serif; font-size: 24px; line-height: 1.5; }
      [data-c='zoloto'] .also { border-top-color: var(--line); }
    </style>
  </head>
  <body>
    <header class="page-head">
      <div class="kicker">Русский бренд · v2 · вариации утверждённого макета</div>
      <h1>Три тональные вариации</h1>
      <p>
        За основу взят утверждённый макет статьи: полноширинный фото-hero, шапка «наличник × СМИ2»
        поверх фото, центрированный титул и светлое тело статьи. Три направления меняют <b>тон,
        типографику и декор</b> — но не структуру. Логотип и палитра — утверждённые.
      </p>
    </header>

    <section class="summary">
      {concepts.map((c) => (
        <article class="sum">
          <div class="sum__top">
            <span class="sum__n">{c.n}</span>
            <span class="sum__name">{c.name}</span>
            <span class="sum__sub">{c.sub}</span>
          </div>
          {c.id === 'chistoe' && (<div class="sw"><span style="background:#fbfaf7"></span><span style="background:#1f1c18"></span><span style="background:#9b080e"></span></div>)}
          {c.id === 'nalichnik' && (<div class="sw"><span style="background:#f5ebd9"></span><span style="background:#2f2318"></span><span style="background:#b8893a"></span><span style="background:#9b080e"></span></div>)}
          {c.id === 'zoloto' && (<div class="sw"><span style="background:#171009"></span><span style="background:#c6a25e"></span><span style="background:#7a1518"></span></div>)}
          <p class="sum__blurb">{c.blurb}</p>
          <a class="jump" href={`#${c.id}`}>Смотреть вживую ↓</a>
        </article>
      ))}
    </section>

    {concepts.map((c) => (
      <section class="band" id={c.id} data-c={c.id}>
        <div class="band__label">
          <span class="band__num">{c.n}</span>
          <span class="band__name">{c.name} · {c.sub}</span>
          <span class="band__tag">{c.tag}</span>
        </div>

        <div class="hero">
          <img class="hero__img" src={heroImg} alt="Ряды винных бутылок в винном погребе" />
          <div class="hero__scrim"></div>
          <div class="hero__nav">
            <span class="logo" style={`--m:url(${logo})`} aria-label="Русский бренд"></span>
            <span class="hero__x">×</span>
            <span class="smi2">СМИ<b>2</b></span>
          </div>
          <div class="hero__center">
            <div class="hero__eyebrow">{hero.cat}</div>
            <h2 class="hero__title">{hero.title}</h2>
            <div class="hero__date">{hero.date}</div>
          </div>
        </div>

        <div class="body">
          <div class="body__col">
            <div class="rosette">
              <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M20 3c3 7 10 14 17 17-7 3-14 10-17 17-3-7-10-14-17-17 7-3 14-10 17-17Z" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="20" cy="20" r="4" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            </div>
            {body.map((p) => (<p>{p}</p>))}
          </div>
        </div>

        <div class="also">
          <div class="also__in">
            <h3 class="also__h">Ещё по теме</h3>
            <div class="grid">
              {cards.map((a) => (
                <article class="card">
                  <img class="card__img" src={a.cover} alt="" loading="lazy" />
                  <span class="card__cat">{a.cat}</span>
                  <h4 class="card__title">{a.title}</h4>
                  <div class="card__date">{a.date}</div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))}

    <footer style="max-width:1100px;margin:0 auto;padding:40px 24px 72px;color:#8a8278;font-size:13px">
      Русский бренд · v2 · тональные вариации утверждённого макета для выбора заказчиком.
    </footer>
  </body>
</html>
