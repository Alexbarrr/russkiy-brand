---
// /concepts — сравнение 3 направлений концепта v2 «Русский бренд».
// Каждое направление — изолированная система токенов на обёртке [data-c],
// применённая к реальному контенту. Утверждённый логотип-наличник тинтуется
// под концепт через CSS-маску (public/logo/lockup.svg — одноцветный currentColor).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logo = `${base}/logo/lockup.svg`;

// Реальные материалы раздела
const heroPhoto =
  'https://img.smi2.net/400x300/39d4d1db010cb4be5d38efca0ec4aaaa25e4a907.jpg?u=aHR0cHM6Ly9tdGRhdGEucnUvdTI0L3Bob3RvQTk1Ni8yMDUyNzM1NTIwMy0wL29yaWdpbmFsLmpwZWc';
const hero = {
  cat: 'Новости',
  title: 'Русское вино — чемпион: «Абрау-Дюрсо» обошло 17 стран на международном конкурсе',
  date: '26.06.2026',
  lead:
    'Международное жюри конкурса TERRAVINO впервые в истории присудило звание Grand Champion International российскому производителю — классическому игристому Brut d’Or Riesling 2022.',
};
const cards = [
  { cat: 'История', cover: `${base}/covers/keramika-gromov.svg`, title: 'Керамика Громовых: как семейная мастерская стала брендом', date: '24.06.2026' },
  { cat: 'Обзор', cover: `${base}/covers/kosmetika-podborka.svg`, title: 'Отечественная косметика: 12 марок, за которыми стоит следить', date: '21.06.2026' },
  { cat: 'Интервью', cover: `${base}/covers/chaynaya-masterskaya.svg`, title: 'Чайная мастерская: русский вкус вне сезонов и трендов', date: '18.06.2026' },
];

const concepts = [
  { id: 'nalichnik', n: '01', name: 'Наличник', sub: 'Резьба', prop: '50 / 35 / 15', tag: 'imperial через дерево',
    blurb: 'Тёплое, тактильное, резное. Наличник — структурный мотив: обложки обрамляются как окна. Serif-first, статус, наследие.' },
  { id: 'utro', n: '02', name: 'Утро', sub: 'Конструктив', prop: '55 / 15 / 30', tag: 'soviet, плакатный',
    blurb: 'Смелое конструктивистское медиа. Плакатный бордо структурно, кондансед-дисплей, асимметрия, диагонали. Наличник — клеймо.' },
  { id: 'zoloto', n: '03', name: 'Золото', sub: 'Империя', prop: '45 / 45 / 10', tag: 'imperial через металл',
    blurb: 'Церемониальная роскошь. Матовое золото доминирует, тёмные фоны, золочёные рамки, симметрия. Дворец/музей, «поставщикъ двора».' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive, noimageindex" />
    <title>Русский бренд — 3 направления концепта</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600;700&family=Oswald:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      body { margin: 0; background: #e7e3db; color: #2c2825;
        font-family: Inter, system-ui, sans-serif; }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
      :focus-visible { outline: 2px solid #9b080e; outline-offset: 3px; border-radius: 2px; }

      /* ---------- страничный каркас сравнения ---------- */
      .page-head { max-width: 1100px; margin: 0 auto; padding: 64px 24px 8px; }
      .kicker { font-family: Oswald, sans-serif; text-transform: uppercase;
        letter-spacing: .28em; font-size: 12px; font-weight: 600; color: #9b080e; }
      .page-head h1 { font-family: 'Cormorant Garamond', serif; font-weight: 600;
        font-size: clamp(32px, 5vw, 52px); line-height: 1.05; margin: 12px 0 10px; }
      .page-head p { max-width: 62ch; color: #57514a; font-size: 16px; line-height: 1.6; margin: 0; }

      .summary { max-width: 1100px; margin: 28px auto 8px; padding: 0 24px;
        display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); }
      @media (max-width: 860px) { .summary { grid-template-columns: 1fr; } }
      .sum { background: #fff; border: 1px solid #d9d3c8; border-radius: 12px; padding: 18px 18px 20px; }
      .sum__top { display: flex; align-items: baseline; gap: 8px; }
      .sum__n { font-family: Oswald, sans-serif; font-weight: 600; color: #b7b0a4; font-size: 13px; letter-spacing: .1em; }
      .sum__name { font-family: 'Cormorant Garamond', serif; font-size: 26px; font-weight: 600; }
      .sum__sub { font-family: Oswald, sans-serif; text-transform: uppercase; letter-spacing: .22em;
        font-size: 11px; color: #9b080e; margin-left: auto; }
      .sum__prop { font-family: Oswald, sans-serif; font-size: 12px; letter-spacing: .16em; color: #8a8278; margin: 8px 0 4px; }
      .sum__bar { display: flex; height: 8px; border-radius: 4px; overflow: hidden; margin-bottom: 12px; }
      .sum__blurb { font-size: 13.5px; line-height: 1.55; color: #57514a; margin: 0 0 14px; }
      .sw { display: flex; gap: 6px; }
      .sw span { width: 26px; height: 26px; border-radius: 6px; border: 1px solid rgba(0,0,0,.08); }
      .jump { display: inline-block; margin-top: 14px; font-family: Oswald, sans-serif;
        text-transform: uppercase; letter-spacing: .18em; font-size: 11px; font-weight: 600;
        color: #2c2825; border-bottom: 1px solid #9b080e; padding-bottom: 2px; }

      /* ---------- логотип-наличник (маска, тинт под концепт) ---------- */
      .logo { width: 128px; aspect-ratio: 400 / 170;
        -webkit-mask: var(--m) center / contain no-repeat; mask: var(--m) center / contain no-repeat;
        background: var(--logo-c, currentColor); }
      .logo--sm { width: 84px; }

      /* ==================================================================
         Базовые компоненты «живой полосы» — читают локальные токены концепта
      ================================================================== */
      .band { --pad: clamp(28px, 5vw, 64px);
        background: var(--bg); color: var(--ink); font-family: var(--font-ui);
        border-top: 1px solid rgba(0,0,0,.06); scroll-margin-top: 12px; }
      .band__label { max-width: 1180px; margin: 0 auto; padding: 22px var(--pad) 0;
        display: flex; align-items: baseline; gap: 14px; }
      .band__num { font-family: var(--font-label); font-weight: 700; letter-spacing: .1em;
        font-size: 13px; color: var(--muted); }
      .band__name { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .24em;
        font-size: 13px; font-weight: 600; color: var(--accent); }
      .band__tag { margin-left: auto; font-size: 12px; color: var(--muted); font-style: italic; }
      .frame { max-width: 1180px; margin: 0 auto; padding: 18px var(--pad) var(--pad); }

      /* шапка-плашка × СМИ2 */
      .plate { display: flex; align-items: center; gap: 18px;
        padding-bottom: 18px; border-bottom: var(--rule); }
      .plate .logo { --logo-c: var(--logo-color); }
      .plate__x { color: var(--muted); font-size: 18px; }
      .smi2 { display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--font-label); font-weight: 600; letter-spacing: .12em; font-size: 15px;
        text-transform: uppercase; color: var(--ink); }
      .smi2 b { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
        background: var(--ink); color: var(--bg); font-family: Inter, sans-serif; font-weight: 700; font-size: 14px; }
      .plate__desc { margin-left: auto; font-size: 13px; color: var(--muted); max-width: 30ch; text-align: right;
        line-height: 1.4; }
      @media (max-width: 640px) { .plate__desc { display: none; } }

      /* hero */
      .hero { margin-top: var(--pad); }
      .eyebrow { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .2em;
        font-size: 11px; font-weight: 600; color: var(--accent); }
      .hero__title { font-family: var(--font-head); line-height: 1.06; margin: 12px 0; }
      .hero__lead { color: var(--ink-2); font-size: 16px; line-height: 1.6; max-width: 60ch; }
      .hero__date { font-family: var(--font-label); font-size: 12px; letter-spacing: .14em; color: var(--muted); }

      /* лента карточек */
      .grid { margin-top: var(--pad); display: grid; gap: 22px; grid-template-columns: repeat(3, 1fr); }
      @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
      .card { position: relative; background: var(--surface); border: var(--card-border);
        border-radius: var(--radius); overflow: hidden; transition: transform .25s ease; }
      .card:hover { transform: translateY(-3px); }
      .card__img { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; background: var(--cream-2, #eee); }
      .card__body { padding: 16px 18px 20px; }
      .card__cat { font-family: var(--font-label); text-transform: uppercase; letter-spacing: .16em;
        font-size: 10px; font-weight: 600; color: var(--bg); background: var(--accent);
        padding: 4px 9px; border-radius: 3px; display: inline-block; }
      .card__title { font-family: var(--font-head); font-size: 21px; line-height: 1.18; margin: 12px 0 10px;
        font-weight: var(--head-weight, 600); }
      .card__date { font-family: var(--font-label); font-size: 11px; letter-spacing: .12em; color: var(--muted); }

      /* делитель-розетка */
      .rosette { display: flex; align-items: center; gap: 16px; margin-top: var(--pad); color: var(--ornament); }
      .rosette::before, .rosette::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: .5; }
      .rosette svg { width: 34px; height: 34px; }

      @media (prefers-reduced-motion: reduce) {
        .card, .card:hover { transition: none; transform: none; }
      }

      /* ==================================================================
         01 · НАЛИЧНИК — imperial через дерево
      ================================================================== */
      [data-c='nalichnik'] {
        --bg: #f4ead8; --surface: #fbf4e6; --cream-2: #efe1c8;
        --ink: #2f2318; --ink-2: #6b4e34; --muted: #9c8465;
        --accent: #9b080e; --gold: #a8823c; --line: #dcc6a4;
        --logo-color: #33251a;
        --font-head: 'Cormorant Garamond', serif; --font-ui: Inter, sans-serif; --font-label: Oswald, sans-serif;
        --rule: 1px solid var(--line); --card-border: 1px solid var(--line); --radius: 6px;
        --ornament: var(--gold); --head-weight: 600;
      }
      [data-c='nalichnik'] .hero__title { font-size: clamp(30px, 4.4vw, 50px); font-weight: 600; }
      /* обложка hero в «оконной» раме */
      [data-c='nalichnik'] .hero__frame { border: 1px solid var(--gold); padding: 10px;
        background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
      [data-c='nalichnik'] .hero__frame img { aspect-ratio: 16/10; width: 100%; object-fit: cover; }
      [data-c='nalichnik'] .hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--pad); align-items: center; }
      @media (max-width: 820px) { [data-c='nalichnik'] .hero { grid-template-columns: 1fr; } }

      /* ==================================================================
         02 · УТРО — soviet конструктив, плакатный бордо структурно
      ================================================================== */
      [data-c='utro'] {
        --bg: #f2efe6; --surface: #ffffff; --cream-2: #e6e1d4;
        --ink: #17140f; --ink-2: #3a352d; --muted: #8a8377;
        --accent: #9b080e; --gold: #9b080e; --line: #d8d2c4;
        --logo-color: #17140f;
        --font-head: Oswald, sans-serif; --font-ui: Inter, sans-serif; --font-label: Oswald, sans-serif;
        --rule: 2px solid var(--ink); --card-border: 1.5px solid var(--ink); --radius: 0px;
        --ornament: var(--ink); --head-weight: 600;
      }
      [data-c='utro'] .band__name { color: var(--ink); }
      /* hero = плакатный красный блок с реверсным дисплеем + фото-полоса */
      [data-c='utro'] .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 0; }
      @media (max-width: 820px) { [data-c='utro'] .hero { grid-template-columns: 1fr; } }
      [data-c='utro'] .hero__text { background: var(--accent); color: #fff; padding: clamp(22px,3vw,40px); }
      [data-c='utro'] .hero__text .eyebrow { color: #fff; opacity: .9; }
      [data-c='utro'] .hero__text .hero__date { color: #fff; opacity: .8; }
      [data-c='utro'] .hero__title { font-family: Oswald, sans-serif; text-transform: uppercase;
        font-weight: 700; letter-spacing: -.01em; font-size: clamp(26px, 3.6vw, 44px); line-height: .98; color: #fff; }
      [data-c='utro'] .hero__lead { color: rgba(255,255,255,.85); }
      [data-c='utro'] .hero__img { object-fit: cover; width: 100%; height: 100%; min-height: 240px;
        filter: grayscale(1) contrast(1.05); }
      [data-c='utro'] .card { box-shadow: 5px 5px 0 var(--ink); }
      [data-c='utro'] .card:hover { box-shadow: 7px 7px 0 var(--accent); }
      [data-c='utro'] .card__cat { border-radius: 0; }
      [data-c='utro'] .card__title { text-transform: none; font-family: Oswald, sans-serif; font-weight: 500; letter-spacing: .005em; }

      /* ==================================================================
         03 · ЗОЛОТО — imperial через металл, церемониальная роскошь
      ================================================================== */
      [data-c='zoloto'] {
        --bg: #171009; --surface: #20180d; --cream-2: #2a2114;
        --ink: #f3ead6; --ink-2: #cbbd9d; --muted: #9a8a68;
        --accent: #c6a25e; --gold: #c6a25e; --line: rgba(198,162,94,.35);
        --logo-color: #c6a25e;
        --font-head: 'Cormorant Garamond', serif; --font-ui: Inter, sans-serif; --font-label: Oswald, sans-serif;
        --rule: 1px solid var(--line); --card-border: 1px solid var(--line); --radius: 2px;
        --ornament: var(--gold); --head-weight: 500;
      }
      [data-c='zoloto'] .smi2 b { background: var(--gold); color: #171009; }
      [data-c='zoloto'] .card__cat { color: #171009; background: var(--gold); }
      [data-c='zoloto'] .hero { text-align: center; max-width: 900px; margin-left: auto; margin-right: auto;
        border: 1px solid var(--line); padding: clamp(24px,3vw,44px);
        box-shadow: inset 0 0 0 4px rgba(198,162,94,.12); }
      [data-c='zoloto'] .hero .eyebrow { color: var(--gold); }
      [data-c='zoloto'] .hero__title { font-family: 'Cormorant Garamond', serif; font-weight: 500;
        font-size: clamp(28px, 4vw, 46px); color: var(--gold); }
      [data-c='zoloto'] .hero__lead { color: var(--ink-2); margin-left: auto; margin-right: auto; }
      [data-c='zoloto'] .hero__inset { width: 180px; margin: 0 auto 18px; border: 1px solid var(--gold);
        padding: 6px; }
      [data-c='zoloto'] .hero__inset img { aspect-ratio: 3/2; object-fit: cover; width: 100%; }
      [data-c='zoloto'] .card__title { color: var(--ink); }
    </style>
  </head>
  <body>
    <header class="page-head">
      <div class="kicker">Русский бренд · v2 · сравнение направлений</div>
      <h1>Три направления концепта</h1>
      <p>
        Одна культура — три интонации. Каждое направление применено к реальному контенту раздела
        (шапка × СМИ2, hero-статья, лента карточек, делитель) с собственной палитрой, шрифтами
        и пропорцией слоёв <b>editorial / imperial / soviet</b>. Логотип-наличник — общий, утверждённый.
      </p>
    </header>

    <!-- Сводка: 3 карточки рядом -->
    <section class="summary">
      {concepts.map((c) => (
        <article class="sum">
          <div class="sum__top">
            <span class="sum__n">{c.n}</span>
            <span class="sum__name">{c.name}</span>
            <span class="sum__sub">{c.sub}</span>
          </div>
          <div class="sum__prop">Слои E / I / S — {c.prop} · {c.tag}</div>
          {c.id === 'nalichnik' && (
            <>
              <div class="sum__bar"><i style="flex:50;background:#33251a"></i><i style="flex:35;background:#a8823c"></i><i style="flex:15;background:#9b080e"></i></div>
              <p class="sum__blurb">{c.blurb}</p>
              <div class="sw"><span style="background:#f4ead8"></span><span style="background:#33251a"></span><span style="background:#a8823c"></span><span style="background:#9b080e"></span></div>
            </>
          )}
          {c.id === 'utro' && (
            <>
              <div class="sum__bar"><i style="flex:55;background:#17140f"></i><i style="flex:15;background:#8a8377"></i><i style="flex:30;background:#9b080e"></i></div>
              <p class="sum__blurb">{c.blurb}</p>
              <div class="sw"><span style="background:#f2efe6"></span><span style="background:#17140f"></span><span style="background:#9b080e"></span><span style="background:#ffffff"></span></div>
            </>
          )}
          {c.id === 'zoloto' && (
            <>
              <div class="sum__bar"><i style="flex:45;background:#171009"></i><i style="flex:45;background:#c6a25e"></i><i style="flex:10;background:#7a1518"></i></div>
              <p class="sum__blurb">{c.blurb}</p>
              <div class="sw"><span style="background:#171009"></span><span style="background:#c6a25e"></span><span style="background:#7a1518"></span><span style="background:#f3ead6"></span></div>
            </>
          )}
          <a class="jump" href={`#${c.id}`}>Смотреть вживую ↓</a>
        </article>
      ))}
    </section>

    <!-- Живые полосы -->
    {concepts.map((c) => (
      <section class="band" id={c.id} data-c={c.id}>
        <div class="band__label">
          <span class="band__num">{c.n}</span>
          <span class="band__name">{c.name} · {c.sub}</span>
          <span class="band__tag">{c.tag} · {c.prop}</span>
        </div>
        <div class="frame">
          <!-- шапка -->
          <div class="plate">
            <span class="logo" style={`--m:url(${logo})`} aria-label="Русский бренд"></span>
            <span class="plate__x">×</span>
            <span class="smi2">СМИ<b>2</b></span>
            <span class="plate__desc">Медиа о российских брендах: истории, интервью, обзоры</span>
          </div>

          <!-- hero (вёрстка своя на концепт) -->
          {c.id === 'nalichnik' && (
            <div class="hero">
              <div class="hero__frame"><img src={heroPhoto} alt="" loading="lazy" /></div>
              <div>
                <div class="eyebrow">{hero.cat}</div>
                <h2 class="hero__title">{hero.title}</h2>
                <p class="hero__lead">{hero.lead}</p>
                <div class="hero__date" style="margin-top:14px">{hero.date}</div>
              </div>
            </div>
          )}
          {c.id === 'utro' && (
            <div class="hero">
              <div class="hero__text">
                <div class="eyebrow">{hero.cat}</div>
                <h2 class="hero__title">{hero.title}</h2>
                <p class="hero__lead">{hero.lead}</p>
                <div class="hero__date" style="margin-top:14px">{hero.date}</div>
              </div>
              <img class="hero__img" src={heroPhoto} alt="" loading="lazy" />
            </div>
          )}
          {c.id === 'zoloto' && (
            <div class="hero">
              <div class="hero__inset"><img src={heroPhoto} alt="" loading="lazy" /></div>
              <div class="eyebrow">{hero.cat}</div>
              <h2 class="hero__title">{hero.title}</h2>
              <p class="hero__lead">{hero.lead}</p>
              <div class="hero__date" style="margin-top:14px">{hero.date}</div>
            </div>
          )}

          <!-- делитель -->
          <div class="rosette">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M20 3c3 7 10 14 17 17-7 3-14 10-17 17-3-7-10-14-17-17 7-3 14-10 17-17Z" stroke="currentColor" stroke-width="1.2"/>
              <circle cx="20" cy="20" r="4" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>

          <!-- лента карточек -->
          <div class="grid">
            {cards.map((a) => (
              <article class="card">
                <img class="card__img" src={a.cover} alt="" loading="lazy" />
                <div class="card__body">
                  <span class="card__cat">{a.cat}</span>
                  <h3 class="card__title">{a.title}</h3>
                  <div class="card__date">{a.date}</div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <footer style="max-width:1100px;margin:0 auto;padding:40px 24px 72px;color:#8a8278;font-size:13px">
      Русский бренд · v2 · черновик направлений для выбора заказчиком. Логотип и палитра — утверждённые.
    </footer>
  </body>
</html>
