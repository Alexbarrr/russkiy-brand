---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Divider from '../components/Divider.astro';
import { CATEGORIES, CATEGORY_ORDER, type CategoryId } from '../consts';

type Entry = {
  category: CategoryId;
  slug: string;
  data: any;
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const all: Entry[] = [];
for (const id of CATEGORY_ORDER) {
  const items = await getCollection(id, ({ data }) => !data.draft);
  for (const item of items) {
    all.push({ category: id, slug: item.id, data: item.data });
  }
}

all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = all;
---

<Layout>
  <section class="border-b border-line">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-28 grid md:grid-cols-12 gap-10 items-end">
      <div class="md:col-span-7">
        <div class="mb-6 flex items-center gap-3">
          <span class="brand-badge">Спецпроект</span>
          <span class="eyebrow text-muted">медиа о современных российских брендах</span>
        </div>
        <h1 class="font-serif text-5xl md:text-7xl leading-[1.05] tracking-tight text-ink">
          Истории тех,<br />
          <span class="italic text-accent">кто делает</span> вещи здесь.
        </h1>
        <p class="mt-8 text-lg md:text-xl text-ink-2 max-w-xl leading-relaxed">
          Большие истории, разговоры с основателями, обзоры и новости индустрии. Один сайт — четыре способа понять, как устроен российский бренд изнутри.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          {CATEGORY_ORDER.map((id) => (
            <a
              href={`${base}/${id}/`}
              class="text-sm border border-line hover:border-accent hover:text-accent transition-colors rounded-full px-4 py-2 text-ink-2"
            >
              {CATEGORIES[id].title}
            </a>
          ))}
        </div>
      </div>
      <div class="md:col-span-5 md:pl-6 md:border-l border-line">
        <div class="text-xs uppercase tracking-widest text-muted mb-3">Что почитать</div>
        <p class="font-serif text-2xl text-ink-2 leading-snug italic">
          «Бренд — это не логотип, а то, что о тебе помнят, когда выходят из магазина.»
        </p>
        <div class="mt-4 text-sm text-muted">Из интервью основателя</div>
      </div>
    </div>
  </section>

  {featured && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="mb-8 flex items-center gap-4">
        <span class="eyebrow text-accent shrink-0">Главное</span>
        <Divider class="flex-1" />
      </div>
      <ArticleCard
        category={featured.category}
        slug={featured.slug}
        title={featured.data.title}
        description={featured.data.description}
        pubDate={featured.data.pubDate}
        cover={featured.data.cover}
        large
      />
    </section>
  )}

  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="mb-8 flex items-center gap-4">
      <span class="eyebrow text-accent shrink-0">Свежее</span>
      <Divider class="flex-1" />
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {rest.slice(0, 9).map((entry) => (
        <ArticleCard
          category={entry.category}
          slug={entry.slug}
          title={entry.data.title}
          description={entry.data.description}
          pubDate={entry.data.pubDate}
          cover={entry.data.cover}
        />
      ))}
    </div>
  </section>
</Layout>
