---
import '../styles/global.css';
import { SITE } from '../consts';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SideRails from '../components/SideRails.astro';
import DirectionSwitcher from '../components/DirectionSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} data-dir="editorial">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved mood-direction before paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var d = localStorage.getItem('rb-dir');
          if (d) document.documentElement.setAttribute('data-dir', d);
        } catch (e) {}
      })();
    </script>

    <SEO {...props} />
  </head>
  <body class="flex flex-col min-h-screen">
    <SideRails />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <DirectionSwitcher />
  </body>
</html>
