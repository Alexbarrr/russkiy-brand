---
import { SITE, CATEGORIES, CATEGORY_ORDER } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
---

<header class="border-b border-line bg-cream">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between gap-8">
    <a href={`${base}/`} class="group flex items-baseline gap-2">
      <span class="font-serif text-2xl tracking-tight text-ink">Русский</span>
      <span class="font-serif text-2xl tracking-tight text-accent italic">бренд</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm">
      {CATEGORY_ORDER.map((id) => {
        const c = CATEGORIES[id];
        const href = `${base}/${c.slug}/`;
        const active = path.startsWith(`/${c.slug}`);
        return (
          <a
            href={href}
            class={`transition-colors hover:text-accent ${active ? 'text-accent' : 'text-ink-2'}`}
          >
            {c.hint}
          </a>
        );
      })}
      <a
        href={`${base}/about/`}
        class={`transition-colors hover:text-accent ${path.startsWith('/about') ? 'text-accent' : 'text-ink-2'}`}
      >
        О проекте
      </a>
    </nav>
  </div>
</header>
