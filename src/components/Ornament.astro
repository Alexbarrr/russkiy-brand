---
// Inline SVG ornament kit for the «Русский бренд» section.
// Inlined (not background-image) so it inherits currentColor for direction
// theming and ignores the production base-path. All stroke linework so a CSS
// `color` recolors it; `fill="currentColor"` for solid nodes.
interface Props {
  kind: 'rail' | 'rosette' | 'mark' | 'scallop';
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;
---
{kind === 'rail' && (
  <svg class={cls} viewBox="0 0 56 240" preserveAspectRatio="xMidYMin" aria-hidden="true">
    <defs>
      <pattern id="rail-motif" width="56" height="120" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1.1">
          <!-- central double spine -->
          <line x1="24" y1="0" x2="24" y2="120" />
          <line x1="32" y1="0" x2="32" y2="120" />
          <!-- medallion diamond -->
          <path d="M28 38 L46 60 L28 82 L10 60 Z" />
          <path d="M28 48 L38 60 L28 72 L18 60 Z" />
          <!-- eyelet rings (lace) -->
          <circle cx="28" cy="8" r="3.2" />
          <circle cx="28" cy="112" r="3.2" />
          <circle cx="11" cy="22" r="3" />
          <circle cx="45" cy="22" r="3" />
          <circle cx="11" cy="98" r="3" />
          <circle cx="45" cy="98" r="3" />
        </g>
        <g fill="currentColor">
          <circle cx="28" cy="60" r="2.1" />
        </g>
      </pattern>
    </defs>
    <rect width="56" height="240" fill="url(#rail-motif)" />
  </svg>
)}

{kind === 'rosette' && (
  <svg class={cls} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
    <circle cx="20" cy="20" r="13" />
    <path d="M20 4 L33 20 L20 36 L7 20 Z" />
    <path d="M20 10 L30 20 L20 30 L10 20 Z" />
    <circle cx="20" cy="20" r="2.4" fill="currentColor" stroke="none" />
  </svg>
)}

{kind === 'mark' && (
  <svg class={cls} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <!-- placeholder монограмма «РБ» под будущий логотип: монолитный знак -->
    <rect x="3" y="3" width="42" height="42" />
    <path d="M16 13 v22 M16 13 h9 a6 6 0 0 1 0 12 h-9 M25 25 l9 10" stroke-width="2.4" />
  </svg>
)}

{kind === 'scallop' && (
  <svg class={cls} viewBox="0 0 48 12" preserveAspectRatio="xMidYMid" aria-hidden="true">
    <defs>
      <pattern id="scallop-motif" width="24" height="12" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1">
          <path d="M0 3 a6 6 0 0 0 12 0 a6 6 0 0 0 12 0" />
          <circle cx="6" cy="9" r="1.4" />
          <circle cx="18" cy="9" r="1.4" />
        </g>
      </pattern>
    </defs>
    <rect width="48" height="12" fill="url(#scallop-motif)" />
  </svg>
)}
