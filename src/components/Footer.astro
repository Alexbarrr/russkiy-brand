---
import { SITE, CATEGORIES, CATEGORY_ORDER } from '../consts';
import Ornament from './Ornament.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-cream-2">
  <!-- ажурная кромка: на мобильном держит «нижнюю» декоративную полосу раздела -->
  <div class="h-3 text-accent opacity-40 overflow-hidden rotate-180">
    <Ornament kind="scallop" id="ftr" class="w-full h-full" />
  </div>
  <div class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-3 gap-10">
    <div>
      <div class="font-serif text-2xl text-ink">
        Русский <span class="italic text-accent">бренд</span>
      </div>
      <p class="mt-3 text-sm text-ink-2 max-w-xs">{SITE.description}</p>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-muted mb-3">Рубрики</div>
      <ul class="space-y-2 text-sm">
        {CATEGORY_ORDER.map((id) => (
          <li>
            <a href={`${base}/${id}/`} class="hover:text-accent transition-colors">
              {CATEGORIES[id].title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest text-muted mb-3">Подписаться</div>
      <ul class="space-y-2 text-sm">
        <li><a href={`${base}/rss.xml`} class="hover:text-accent transition-colors">RSS-лента</a></li>
        <li><a href={`${base}/about/`} class="hover:text-accent transition-colors">О проекте</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="max-w-6xl mx-auto px-6 py-5 text-xs text-muted flex justify-between">
      <span>© {year} {SITE.title}</span>
      <span>Сделано с любовью к делу</span>
    </div>
  </div>
</footer>
